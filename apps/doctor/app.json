{
  "expo": {
    "name": "توريد",
    "slug": "tawreed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-1024.png",
    "scheme": "tawreed",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon-1024.png",
      "bundleIdentifier": "com.tawreed.doctor"
    },
    "android": {
      "package": "com.tawreed.doctor",
      "adaptiveIcon": {
        "backgroundColor": "#0E5245",
        "foregroundImage": "./assets/images/maskable-512.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon-tawreed.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "apiRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E5245",
          "image": "./assets/images/splash-tawreed.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك فقط لتحديد عنوان توصيل طلباتك."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
