{
  "expo": {
    "name": "Tawreed Doctor",
    "slug": "tawreed-doctor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tawreed-doctor",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.tawreed.doctor",
      "adaptiveIcon": {
        "backgroundColor": "#064652",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "apiRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173F43",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك فقط لتحديد عنوان توصيل طلباتك."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
