# Public values embedded in the Expo Android/Web client.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
EXPO_PUBLIC_MEDIA_PUBLIC_BASE_URL=
# Browser key: restrict to Tawreed HTTP referrers and Maps JavaScript API only.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Native build keys: restrict each key to its app identifier and Maps SDK only.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
