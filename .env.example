# Expo public client configuration belongs in apps/doctor/.env.
# Use apps/doctor/.env.example as the template so Expo loads it from its package root.

# EAS project linkage (do not invent a value; set after `eas init`).
EAS_PROJECT_ID=

# Server-only examples. Never prefix these with EXPO_PUBLIC_ and never bundle them.
SUPABASE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
